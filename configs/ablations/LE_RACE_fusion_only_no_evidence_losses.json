{
  "backbone_model_path": "roberta-base",
  "data_path": "./data/hart_split_evidence/train_graph.jsonl",
  "val_data_path": "./data/hart_split_evidence/val_graph.jsonl",
  "test_data_path": "./data/hart_split_evidence/test_graph.jsonl",
  "output_dir": "results/le_race/fusion_only_no_evidence_losses",
  "bert_dim": 768,
  "max_seq_length": 512,
  "device": "cuda",
  "seed": 3407,
  "num_workers": 4,
  "print_freq": 10,
  "dist_url": "env://",
  "epochs": 20,
  "batch_size": 16,
  "lr": 2.5e-05,
  "lr_scheduler": {
    "type": "linear",
    "warmup_ratio": 0.1
  },
  "weight_decay": 0.01,
  "clip_grad_norm": 1.0,
  "loss": {
    "use_supcon": true,
    "temperature": 0.07,
    "ce_weight": 1.0,
    "use_evidence_loss": false,
    "evidence_weight": 0.0,
    "use_mil_loss": false,
    "mil_weight": 0.0,
    "mil_margin": 0.3,
    "mil_topk_ratio": 0.15,
    "use_sparse_loss": false,
    "sparse_weight": 0.0
  },
  "use_stratified_sampler": true,
  "early_stopping_patience": 5,
  "early_stopping_metric": "f1_macro",
  "num_classes": 4,
  "feature_dim": 128,
  "gnn_hidden_dim": 512,
  "num_gnn_layers": 2,
  "num_heads": 4,
  "unfreeze_bert_layers": 1,
  "relation_table_path": "./utils/relation_table.txt",
  "graph": {
    "graph_builder_type": "rst",
    "gnn_layer_type": "RGCN",
    "rst_use_nuclearity": false,
    "use_distinct_reverse_edges": false,
    "rgcn_num_bases": 10,
    "gnn_dropout": 0.5,
    "proj_dropout": 0.1,
    "pooling_strategy": "root",
    "classifier_type": "mlp",
    "classifier_dropout": 0.1,
    "debug_log_zero_feature_ratio": false,
    "debug_save_graph_path": "",
    "debug_save_batch_indices": [],
    "use_local_evidence": true,
    "evidence_pooling": "soft",
    "evidence_topk_ratio": 0.15,
    "evidence_warmup_epochs": 0,
    "evidence_dropout": 0.1,
    "fusion_dropout": 0.1,
    "disable_evidence_pooling": false
  },
  "checkpoint_metric": "tpr_at_1_fpr_macro",
  "checkpoint_tie_breaker": "auroc_macro",
  "best_checkpoint_metric": "tpr_at_1_fpr_macro"
}
